APP_NAME=Astra LMS API
DATABASE_URL=sqlite:///./astra_lms.db
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Sign-In (OAuth 2.0 Web Client ID — same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Gemini AI — RAG chat / embeddings (Lumina)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant — use Docker (recommended): docker run -d --name qdrant -p 6333:6333 qdrant/qdrant
# Or set QDRANT_PATH=./qdrant_storage for embedded local mode without Docker
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=astra_documents
QDRANT_PATH=

# Groq — course structure (and future assessments)
GROQ_API_KEY_STRUCTURE=
GROQ_API_KEY_NOTES=
GROQ_API_KEY_QUIZ=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini — parallel lesson notes (up to 3 keys)
GEMINI_API_KEY_NOTES_1=
GEMINI_API_KEY_NOTES_2=
GEMINI_API_KEY_NOTES_3=
GEMINI_MODEL=gemini-3.6-flash

# YouTube Data API
YOUTUBE_API_KEY=

# Coding platform integration
CODING_PLATFORM_API_URL=http://127.0.0.1:8011/api/v1
CODING_PLATFORM_FRONTEND_URL=http://127.0.0.1:5180
CODING_SYNC_SECRET=change_me_coding_sync_secret
CODING_SSO_SECRET=change_me_coding_sso_secret

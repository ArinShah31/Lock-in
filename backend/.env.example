APP_NAME=Astra LMS API
DATABASE_URL=sqlite:///./astra_lms.db
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# gemini | groq | mock
AI_PROVIDER=groq
GEMINI_API_KEY=
# Optional: comma-separated extra keys for rate-limit rotation only (not accuracy).
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-3.6-flash
# Free real AI: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
UPLOADS_DIR=uploads
